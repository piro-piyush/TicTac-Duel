# ============================================================
# Tic Tac Duel - Git Ignore
# Flutter Frontend
# ============================================================


# ============================================================
# Miscellaneous
# ============================================================

*.class
*.log
*.pyc
*.swp
*.swo
*.tmp
*.temp
*.bak
*.pid
*.pid.lock

.DS_Store
Thumbs.db
Desktop.ini

.atom/
.build/
.buildlog/
.history/
.svn/
.swiftpm/
migrate_working_dir/


# ============================================================
# IDE - IntelliJ / Android Studio
# ============================================================

*.iml
*.ipr
*.iws
.idea/


# ============================================================
# IDE - VS Code
# ============================================================

# Keep project-specific VS Code settings if needed.
.vscode/*.code-workspace


# ============================================================
# Flutter / Dart
# ============================================================

/frontend/.dart_tool/
/frontend/.flutter-plugins
/frontend/.flutter-plugins-dependencies
/frontend/.pub-cache/
/frontend/.pub/
/frontend/build/
/frontend/coverage/

/frontend/**/doc/api/

/frontend/ios/Flutter/.last_build_id

# Flutter symbolication
/frontend/app.*.symbols

# Flutter obfuscation
/frontend/app.*.map.json

# Widget Preview
/frontend/.widget_preview/


# ============================================================
# Android Build Artifacts
# ============================================================

/frontend/android/app/debug/
/frontend/android/app/profile/
/frontend/android/app/release/

/frontend/android/.gradle/
/frontend/android/local.properties/

/frontend/android/.cxx/
/frontend/android/.externalNativeBuild/
/frontend/android/app/.cxx/
/frontend/android/app/build/


# ============================================================
# Android Signing - NEVER COMMIT
# ============================================================

/frontend/android/key.properties
/frontend/android/app/upload-keystore.jks

# All keystore / signing files
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key


# ============================================================
# Environment / Secrets
# ============================================================

/frontend/.env
/frontend/.env.*

!/frontend/.env.example

# Global environment files
.env
.env.*

!.env.example


# ============================================================
# Local Database / Generated Data
# ============================================================

*.sqlite
*.sqlite3
*.db
*.db-journal


# ============================================================
# OS / Tool Generated Files
# ============================================================

*.orig
*.rej