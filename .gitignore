# ============================================================

# Tic Tac Duel - Git Ignore

# Flutter Frontend + Node.js Backend

# ============================================================

# ============================================================

# Miscellaneous

# ============================================================

*.class
*.log
*.pyc
*.swp
*.swo
*.tmp
*.temp
*.bak
*.pid
*.pid.lock

.DS_Store
Thumbs.db
Desktop.ini

.atom/
.build/
.buildlog/
.history/
.svn/
.swiftpm/
migrate_working_dir/

# ============================================================

# IDE - IntelliJ / Android Studio

# ============================================================

*.iml
*.ipr
*.iws

.idea/

# ============================================================

# IDE - VS Code

# ============================================================

# Uncomment if you don't want VS Code settings committed

# .vscode/

# Local VS Code configuration

.vscode/*.code-workspace

# ============================================================

# Frontend - Flutter / Dart

# ============================================================

/frontend/.dart_tool/
/frontend/.flutter-plugins
/frontend/.flutter-plugins-dependencies
/frontend/.pub-cache/
/frontend/.pub/
/frontend/build/
/frontend/coverage/

/frontend/**/doc/api/

/frontend/ios/Flutter/.last_build_id

# Flutter symbolication

/frontend/app.*.symbols

# Flutter obfuscation

/frontend/app.*.map.json

# Widget Preview

/frontend/.widget_preview/

# ============================================================

# Frontend - Android Build Artifacts

# ============================================================

/frontend/android/app/debug/
/frontend/android/app/profile/
/frontend/android/app/release/

/frontend/android/.gradle/
/frontend/android/local.properties/
/frontend/android/.cxx/
/frontend/android/.externalNativeBuild/

# Android generated files

/frontend/android/app/.cxx/
/frontend/android/app/build/

# ============================================================

# Android Signing - NEVER COMMIT

# ============================================================

/frontend/android/key.properties
/frontend/android/app/upload-keystore.jks

# All keystore / signing files

*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key

# ============================================================

# Frontend - Environment / Secrets

# ============================================================

/frontend/.env
/frontend/.env.*
!/frontend/.env.example

# ============================================================

# Backend - Node.js

# ============================================================

/backend/node_modules/
/backend/dist/
/backend/build/
/backend/coverage/

/backend/.nyc_output/

# ============================================================

# Backend - TypeScript

# ============================================================

*.tsbuildinfo

# ============================================================

# Backend - Environment / Secrets

# ============================================================

/backend/.env
/backend/.env.*
!/backend/.env.example

# ============================================================

# Backend - Logs

# ============================================================

/backend/npm-debug.log*
/backend/yarn-debug.log*
/backend/yarn-error.log*
/backend/pnpm-debug.log*

# ============================================================

# Backend - Runtime Data

# ============================================================

/backend/*.pid
/backend/*.seed
/backend/*.pid.lock

# ============================================================

# Backend - Editor Configuration

# ============================================================

/backend/.vscode/launch.json

# ============================================================

# Backend - Drizzle ORM

# ============================================================

# Drizzle migration metadata

/backend/drizzle/meta/

# Temporary Drizzle files

/backend/drizzle/*.sql.bak
/backend/drizzle/*.tmp

# ============================================================

# Backend - Test / Temporary Files

# ============================================================

/backend/.eslintcache
/backend/.stylelintcache

# ============================================================

# Global Environment Files

# ============================================================

.env
.env.*
!.env.example

# ============================================================

# Global Secrets / Credentials

# ============================================================

*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# ============================================================

# Local Database / Generated Data

# ============================================================

*.sqlite
*.sqlite3
*.db
*.db-journal

